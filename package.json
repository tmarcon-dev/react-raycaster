{
  "name": "react-raycaster",
  "version": "0.1.1",
  "private": false,
  "author": "Thais Marcon <mthais.web@gmail.com> (https://thais-marcon.com/)",
  "description": "A fully customizable raycaster game engine as a React component.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmarcon-dev/react-raycaster.git"
  },
  "homepage": "https://github.com/tmarcon-dev/react-raycaster#readme",
  "bugs": {
    "url": "https://github.com/tmarcon-dev/react-raycaster/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "react",
    "raycaster",
    "raycasting",
    "game",
    "engine"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
